# ── Banco de dados (Supabase) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:SENHA@db.SEU_ID.supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://mapeia.ai
API_URL=https://api.mapeia.ai

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Crie em upstash.com → Redis → formato: "rediss://:TOKEN@HOST:PORT"
REDIS_URL=rediss://:TOKEN@SEU_HOST.upstash.io:6379

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=/app/storage

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Mapeia.AI <no-reply@mapeia.ai>

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_AVULSO_150=price_xxxxxxxxxxxx
STRIPE_PRICE_AVULSO_400=price_xxxxxxxxxxxx
STRIPE_PRICE_AVULSO_1200=price_xxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxx
