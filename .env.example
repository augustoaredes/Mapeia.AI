# ============================================
# Mapeia.AI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================

# --- Banco de Dados ---
DATABASE_URL="postgresql://mapeia:mapeia_secret@localhost:5432/mapeia_db"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Autenticação ---
NEXTAUTH_SECRET="gere-um-segredo-forte-aqui"
NEXTAUTH_URL="http://localhost:3000"

# --- API Backend ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT=3001

# --- Storage ---
# Local (padrão para desenvolvimento)
STORAGE_DRIVER="local"
STORAGE_BASE_PATH="./storage"

# S3 (produção — preencha quando migrar)
# STORAGE_DRIVER="s3"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="sa-east-1"
# AWS_S3_BUCKET=""

# --- Pagamento (Stripe) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Ambiente ---
NODE_ENV="development"
